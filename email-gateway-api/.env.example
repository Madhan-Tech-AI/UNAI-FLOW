PORT=3002

# Secret API Key to authenticate requests from UNAI Flow Backend
EMAIL_GATEWAY_API_KEY=unai_email_sec_8a7d32f91bc4028e

# Default Sender
EMAIL_FROM_EMAIL=your-email@gmail.com
EMAIL_FROM_NAME=UNAI Flow

# ─── Gmail API over HTTPS (Port 443) ───
# These credentials are obtained by running:
#   npx tsx scripts/get-gmail-token.ts <CLIENT_ID> <CLIENT_SECRET>
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_USER_EMAIL=your-email@gmail.com
