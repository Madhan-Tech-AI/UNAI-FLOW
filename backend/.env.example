# ==============================================================================
# UNAI Flow WhatsApp Channels API Gateway Configuration
# ==============================================================================

APP_ENV=production
APP_URL=http://localhost:8000
PORT=8000

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Security Secrets (Generate using: openssl rand -hex 16)
SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
API_KEY_PEPPER=unai_flow_pepper_secret_string
WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret

# External WhatsApp Channel API Daemon (Playwright / Baileys Engine)
WCA_API_URL=https://unai-whatsapp-channelapi.onrender.com
WCA_API_KEY=your-wca-engine-api-key

# Rate Limiting (Requests / minute / key)
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ORIGINS=["*"]

# ==============================================================================
# Email Automation Configuration (Self-Hosted Gateway, SMTP, Resend, or SendGrid)
# ==============================================================================
# Provider selection: 'unai_gateway', 'smtp', 'resend', or 'sendgrid'
EMAIL_PROVIDER=unai_gateway
EMAIL_FROM_EMAIL=noreply@yourdomain.com
EMAIL_FROM_NAME=UNAI Flow
EMAIL_REPLY_TO=support@yourdomain.com

# UNAI Email Gateway (Self-Hosted Microservice with Custom API Key)
EMAIL_GATEWAY_URL=https://your-email-gateway.up.railway.app
EMAIL_GATEWAY_API_KEY=unai_email_sec_8a7d32f91bc4028e

# Standard SMTP Provider Options (Default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_STARTTLS=true

# Resend Provider Options (Optional: set EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_resend_api_key

# SendGrid Provider Options (Optional: set EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Queue & Delivery Rate Limiting
EMAIL_RATE_LIMIT_PER_SECOND=10
EMAIL_BATCH_SIZE=50
EMAIL_MAX_RETRIES=3
