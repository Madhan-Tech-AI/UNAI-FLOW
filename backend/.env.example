# ==============================================================================
# UNAI Flow WhatsApp Channels API Gateway Configuration
# ==============================================================================

APP_ENV=production
APP_URL=http://localhost:8000
PORT=8000

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Security Secrets (Generate using: openssl rand -hex 16)
SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
API_KEY_PEPPER=unai_flow_pepper_secret_string
WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret

# External WhatsApp Channel API Daemon (Playwright / Baileys Engine)
WCA_API_URL=https://unai-whatsapp-channelapi.onrender.com
WCA_API_KEY=your-wca-engine-api-key

# Rate Limiting (Requests / minute / key)
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ORIGINS=["*"]
